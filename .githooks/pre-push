#!/bin/sh
# .githooks/pre-push — hadith-reels (smart version)
#
# REQUIRES core.hooksPath=.githooks. Check with `git config core.hooksPath`.
# If it is empty, Git reads .git/hooks/ instead and this file does nothing,
# invisibly — an older copy there prints the same banner (P119).

echo ""
echo "🎬 Hadith Reels — Smart pre-push scanner..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

REMOTE_REF=$(git rev-parse --verify origin/main 2>/dev/null)
if [ -z "$REMOTE_REF" ]; then
  CHANGED_FILES=$(git diff --name-only $(git hash-object -t tree /dev/null) HEAD)
else
  CHANGED_FILES=$(git diff --name-only origin/main HEAD)
fi

if [ -z "$CHANGED_FILES" ]; then
  echo "✅ No changes — nothing to check"
  exit 0
fi

echo "📋 Files changed:"
echo "$CHANGED_FILES" | sed 's/^/   /'
echo ""

DOC_PATTERNS="\.md$|\.txt$|fix_patterns|CLAUDE|AGENTS|QA_STANDARDS|CI_WORKFLOW|README|CHANGELOG|\.githooks"
API_PATTERNS="^app/api/|route\.ts$"
UI_PATTERNS="^app/page\.tsx$|^app/admin/|^app/layout\.tsx$|^components/|^lib/"
REMOTION_PATTERNS="^remotion/"
CONFIG_PATTERNS="next\.config|playwright\.config|tsconfig|package\.json$"
TEST_PATTERNS="^tests/|\.spec\.ts$"
TS_SCRIPT_PATTERNS="^scripts/.*\.ts$"
PY_PATTERNS="\.py$"
PS1_PATTERNS="\.ps1$"
JSON_PATTERNS="\.json$"

HAS_DOC=$(echo "$CHANGED_FILES" | grep -E "$DOC_PATTERNS" | wc -l | tr -d ' ')
HAS_API=$(echo "$CHANGED_FILES" | grep -E "$API_PATTERNS" | wc -l | tr -d ' ')
HAS_UI=$(echo "$CHANGED_FILES" | grep -E "$UI_PATTERNS" | wc -l | tr -d ' ')
HAS_REMOTION=$(echo "$CHANGED_FILES" | grep -E "$REMOTION_PATTERNS" | wc -l | tr -d ' ')
HAS_PY=$(echo "$CHANGED_FILES" | grep -E "$PY_PATTERNS" | wc -l | tr -d ' ')
HAS_TSSCRIPT=$(echo "$CHANGED_FILES" | grep -E "$TS_SCRIPT_PATTERNS" | wc -l | tr -d ' ')
HAS_TEST=$(echo "$CHANGED_FILES" | grep -E "$TEST_PATTERNS" | wc -l | tr -d ' ')
HAS_PS1=$(echo "$CHANGED_FILES" | grep -E "$PS1_PATTERNS" | wc -l | tr -d ' ')
HAS_JSON=$(echo "$CHANGED_FILES" | grep -E "$JSON_PATTERNS" | wc -l | tr -d ' ')
HAS_CONFIG=$(echo "$CHANGED_FILES" | grep -E "$CONFIG_PATTERNS" | wc -l | tr -d ' ')
NON_DOC=$(echo "$CHANGED_FILES" | grep -vE "$DOC_PATTERNS" | wc -l | tr -d ' ')

echo "📊 Classification: Doc=$HAS_DOC API=$HAS_API UI=$HAS_UI Remotion=$HAS_REMOTION Config=$HAS_CONFIG Py=$HAS_PY Ps1=$HAS_PS1 Json=$HAS_JSON TSScript=$HAS_TSSCRIPT Test=$HAS_TEST"
echo ""

# Doc-only → skip
if [ "$NON_DOC" -eq 0 ]; then
  echo "✅ Doc-only push — skipping tests"
  exit 0
fi

FAILED=0

# P127: an empty or undefined *_PATTERNS is a live misrouting bug, not a style
# issue. `grep -E ""` matches EVERY line, so the counter reads high and the
# wrong branch runs — proven by renaming PY_PATTERNS, which produced Py=1 on a
# hook-only change. The first version of this check tested whether the COUNTER
# was set; it always is, because an empty pattern still yields a number. Test
# the pattern itself.
for p in DOC_PATTERNS API_PATTERNS UI_PATTERNS REMOTION_PATTERNS CONFIG_PATTERNS \
         TEST_PATTERNS PY_PATTERNS PS1_PATTERNS JSON_PATTERNS TS_SCRIPT_PATTERNS; do
  eval "val=\$$p"
  if [ -z "$val" ]; then
    echo "❌ $p is empty or undefined — an empty regex matches EVERY file"
    FAILED=1
  fi
done

# find a python interpreter once — used by the Python and JSON branches
PY_BIN=""
for c in python python3 py; do
  if command -v "$c" > /dev/null 2>&1; then PY_BIN="$c"; break; fi
done

# TypeScript always
echo "▶ TypeScript check..."
npx tsc --noEmit 2>&1
if [ $? -ne 0 ]; then echo "❌ TypeScript errors"; FAILED=1; fi
[ $FAILED -eq 0 ] && echo "✅ TypeScript OK"

# Config/next.config → build check
if [ "$HAS_CONFIG" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "▶ Build check (config changed)..."
  npm run build 2>&1
  if [ $? -ne 0 ]; then echo "❌ Build failed"; FAILED=1; fi
  [ $FAILED -eq 0 ] && echo "✅ Build OK"
fi

# Remotion compositions → just tsc (can't render in pre-push)
if [ "$HAS_REMOTION" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "✅ Remotion changes — TypeScript check sufficient (render locally after push)"
fi

# Python agents → syntax parse + offline unit tests
# tsc cannot read Python. Before this branch existed (P119), a pure-Python
# commit ran the TypeScript check, passed, and pushed untested — the four
# agents that gate every published reel had no CI coverage at all.
if [ "$HAS_PY" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "▶ Python checks (agent scripts changed)..."

  if [ -z "$PY_BIN" ]; then
    echo "❌ Python changed but no python interpreter on PATH"
    FAILED=1
  else
    # every changed .py must at least parse
    for f in $(echo "$CHANGED_FILES" | grep -E "$PY_PATTERNS"); do
      if [ -f "$f" ]; then
        "$PY_BIN" -c "import ast,sys; ast.parse(open(sys.argv[1],encoding='utf-8').read())" "$f" 2>&1
        if [ $? -ne 0 ]; then echo "❌ Python syntax error in $f"; FAILED=1; fi
      fi
    done

    # offline unit tests for the sourcing lib — no network, ~0.3s
    if [ $FAILED -eq 0 ] && [ -d "scripts/lib" ]; then
      "$PY_BIN" -m pytest scripts/lib -q 2>&1
      if [ $? -ne 0 ]; then echo "❌ pytest failed"; FAILED=1; fi
    fi
  fi

  [ $FAILED -eq 0 ] && echo "✅ Python OK"
fi

# scripts/*.ts → run the transliterator suite (P126)
# uzbek-translit.ts has 11 passing tests that the hook never invoked. It is the
# only thing standing between the pipeline and okina corruption in every Uzbek
# reel — the defect that reached five captions. Tests existing but never run is
# the P119 shape: the gate cannot fail for a category nobody named.
if [ "$HAS_TSSCRIPT" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "▶ TypeScript script checks..."

  if [ -f "scripts/lib/uzbek-translit.test.ts" ]; then
    npx tsx scripts/lib/uzbek-translit.test.ts 2>&1
    if [ $? -ne 0 ]; then echo "❌ uzbek-translit tests failed"; FAILED=1; fi
  fi

  [ $FAILED -eq 0 ] && echo "✅ TypeScript scripts OK"
fi

# PowerShell → parse without executing (P123)
# render-reel.ps1 IS the render pipeline and IS the asset gate. Before this
# branch, a change to it was checked only by `npx tsc --noEmit`, which cannot
# read PowerShell. P121's own fix — the scene-clip gate — shipped that way.
if [ "$HAS_PS1" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "▶ PowerShell checks (scripts changed)..."

  PS_BIN=""
  for c in pwsh powershell; do
    if command -v "$c" > /dev/null 2>&1; then PS_BIN="$c"; break; fi
  done

  if [ -z "$PS_BIN" ]; then
    echo "❌ .ps1 changed but no pwsh/powershell on PATH — cannot verify"
    FAILED=1
  else
    for f in $(echo "$CHANGED_FILES" | grep -E "$PS1_PATTERNS"); do
      if [ -f "$f" ]; then
        # Tokenize parses the file WITHOUT running it. A parse error is
        # returned in $errs, not thrown, so exit non-zero explicitly.
        "$PS_BIN" -NoProfile -NonInteractive -Command "
          \$errs = \$null
          \$null = [System.Management.Automation.PSParser]::Tokenize(
            (Get-Content -Raw -LiteralPath '$f'), [ref]\$errs)
          if (\$errs -and \$errs.Count -gt 0) {
            \$errs | ForEach-Object { Write-Host \"  \$(\$_.Message) (line \$(\$_.Token.StartLine))\" }
            exit 1
          }
          exit 0" 2>&1
        if [ $? -ne 0 ]; then echo "❌ PowerShell parse error in $f"; FAILED=1; fi
      fi
    done
  fi

  [ $FAILED -eq 0 ] && echo "✅ PowerShell OK"
fi

# JSON → must parse (P123)
# NOTE, honestly: this catches a trailing comma. It would NOT have caught the
# 2026-08-25 asset-registry defect, where eight .mp4 entries were filed under
# the "audio" section — that file was valid JSON and wrong anyway. Structural
# correctness is audit-assets.py's job, not a syntax check's.
if [ "$HAS_JSON" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "▶ JSON checks..."

  if [ -z "$PY_BIN" ]; then
    echo "❌ .json changed but no python interpreter on PATH — cannot verify"
    FAILED=1
  else
    for f in $(echo "$CHANGED_FILES" | grep -E "$JSON_PATTERNS"); do
      if [ -f "$f" ]; then
        "$PY_BIN" -c "import json,sys; json.load(open(sys.argv[1],encoding='utf-8'))" "$f" 2>&1
        if [ $? -ne 0 ]; then echo "❌ invalid JSON in $f"; FAILED=1; fi
      fi
    done

    # the asset registry has structure beyond syntax — let its own auditor speak
    if [ $FAILED -eq 0 ] && echo "$CHANGED_FILES" | grep -q "assets/asset-registry.json"; then
      if [ -f "scripts/audit-assets.py" ]; then
        echo "  asset registry changed — running audit (reports only, never blocks):"
        "$PY_BIN" scripts/audit-assets.py --audit 2>&1 | tail -6
      fi
    fi
  fi

  [ $FAILED -eq 0 ] && echo "✅ JSON OK"
fi

# API or UI → E2E tests
# P127: TEST_PATTERNS was defined but never counted and never used — a change
# to the suite itself ran tsc alone. The test file had no coverage.
if [ "$((HAS_API + HAS_UI + HAS_TEST))" -gt 0 ] && [ $FAILED -eq 0 ]; then
  echo "▶ E2E tests (code or tests changed)..."

  # Ensure dev server is running on 3002
  DEV_PID=""
  if ! curl -s http://localhost:3002 > /dev/null 2>&1; then
    echo "  Starting dev server on 3002..."
    npx next dev -p 3002 > /dev/null 2>&1 &
    DEV_PID=$!
    sleep 8
  fi

  BASE_URL=http://localhost:3002 npx playwright test tests/hadith-reels.spec.ts \
    --project=chromium --reporter=list --workers=2 2>&1
  TEST_EXIT=$?

  # Stop dev server if we started it
  if [ -n "$DEV_PID" ]; then
    kill $DEV_PID 2>/dev/null
  fi

  if [ $TEST_EXIT -ne 0 ]; then echo "❌ E2E tests failed"; FAILED=1; fi
  [ $FAILED -eq 0 ] && echo "✅ E2E tests OK"
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -ne 0 ]; then
  echo "❌ Push blocked — fix issues above"
  exit 1
else
  echo "✅ All checks passed — pushing..."
  exit 0
fi
