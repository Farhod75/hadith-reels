51\u0650\u064a \u0641\u064e\u0639\u064e\u0644\u0652\u062a\u064f \u0643\u064e\u0627\u0646\u064e \u0643\u064e\u0630\u064e\u0627 \u0648\u064e\u0643\u064e\u0630\u064e\u0627\u060c \u0648\u064e\u0644\u064e\u0643\u0650\u0646\u0652 \u0642\u064f\u0644\u0652 \u0642\u064e\u062f\u064e\u0631\u064f \u0627\u0644\u0644\u0647\u0650 \u0648\u064e\u0645\u064e\u0627 \u0634\u064e\u0627\u0621\u064e \u0641\u064e\u0639\u064e\u0644\u064e\u060c \u0641\u064e\u0625\u0650\u0646\u0651\u064e (\u0644\u064e\u0648\u0652) \u062a\u064e\u0641\u0652\u062a\u064e\u062d\u064f \u0639\u064e\u0645\u064e\u0644\u064e \u0627\u0644\u0634\u0651\u064e\u064a\u0652\u0637\u064e\u0627\u0646\u0650\u00bb.","attribution":"\u0631\u0648\u0627\u0647 \u0645\u0633\u0644\u0645","grade":"\u0635\u062d\u064a\u062d","explanation":"\u064a\u064f\u0628\u064e\u064a\u0651\u0650\u0646\u064f \u0627\u0644\u0646\u0628\u064a\u0651\u064f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0623\u0646\u0651\u064e \u0627\u0644\u0645\u0624\u0645\u0646\u064e \u062e\u064a\u0631\u064c \u0643\u0644\u0651\u064f\u0647\u060c \u0648\u0644\u0643\u0646 \u0627\u0644\u0645\u0624\u0645\u0646 \u0627\u0644\u0642\u0648\u064a \u0641\u064a \u0625\u064a\u0645\u0627\u0646\u0650\u0647\u0650 \u0648\u0639\u0632\u064a\u0645\u062a\u0650\u0647\u0650 \u0648\u0645\u0627\u0644\u0650\u0647\u0650 \u0648\u063a\u064a\u0631\u0650\u0647\u0627 \u0645\u0650\u0646 \u0623\u0648\u062c\u0647 \u0627\u0644\u0642\u0648\u0629 \u062e\u064a\u0631\u064c \u0648\u0623\u062d\u0628\u0651\u064f \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648\u062c\u0644 \u0645\u0646 \u0627\u0644\u0645\u0624\u0645\u0646 \u0627\u0644\u0636\u0639\u064a\u0641. \n\u062b\u0645 \u0623\u0648\u0635\u0649 \u0627\u0644\u0646\u0628\u064a\u0651\u064f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0627\u0644\u0645\u0624\u0645\u0646\u064e \u0628\u0627\u0644\u0623\u062e\u0630\u0650 \u0628\u0627\u0644\u0623\u0633\u0628\u0627\u0628\u0650 \u0641\u064a\u0645\u0627 \u064a\u0646\u0641\u0639\u0647 \u0645\u0646 \u0623\u0645\u0648\u0631 \u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u0644\u0622\u062e\u0631\u0629\u060c \u0645\u0639 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0648\u062a\u0639\u0627\u0644\u0649\u060c \u0648\u0627\u0644\u0627\u0633\u062a\u0639\u0627\u0646\u0629 \u0628\u0647\u060c \u0648\u0627\u0644\u062a\u0648\u0643\u0644 \u0639\u0644\u064a\u0647. \n\u062b\u0645 \u0646\u064e\u0647\u0649 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0639\u0646 \u0627\u0644\u0639\u064e\u062c\u0652\u0632\u0650 \u0648\u0627\u0644\u0643\u064e\u0633\u064e\u0644\u0650 \u0648\u0627\u0644\u062a\u0651\u064e\u062b\u064e\u0627\u0642\u064f\u0644\u0650 \u0639\u0646 \u0641\u0650\u0639\u0652\u0644\u0650 \u0645\u0627 \u064a\u0646\u0641\u0639 \u0641\u064a \u0627\u0644\u062f\u0627\u0631\u064a\u0646. \n\u0641\u0625\u0630\u0627 \u0627\u062c\u062a\u0647\u062f \u0627\u0644\u0645\u0624\u0645\u0646 \u0641\u064a \u0627\u0644\u0639\u0645\u0644\u060c \u0648\u0623\u062e\u0630 \u0628\u0627\u0644\u0623\u0633\u0628\u0627\u0628\u060c \u0645\u0633\u062a\u0639\u064a\u0646\u064b\u0627 \u0628\u0627\u0644\u0644\u0647\u060c \u0648\u0637\u0644\u0628 \u0627\u0644\u062e\u064a\u0631 \u0645\u0646 \u0627\u0644\u0644\u0647\u060c \u0641\u0644\u0627 \u0639\u0644\u064a\u0647 \u0628\u0639\u062f\u0647\u0627 \u0625\u0644\u0627 \u0623\u0646\u0652 \u064a\u064f\u0641\u064e\u0648\u0651\u0650\u0636\u064e \u0623\u0645\u0631\u064e\u0647 \u0643\u0644\u0651\u064e\u0647 \u0644\u0644\u0647\u060c \u0648\u0644\u064a\u0639\u0644\u0645 \u0623\u0646\u0651\u064e \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648\u062c\u0644 \u0647\u0648 \u0627\u0644\u062e\u064a\u0631\u060c \n\u0641\u0625\u0630\u0627 \u0623\u0635\u0627\u0628\u062a\u0647 \u0628\u0639\u062f \u0630\u0644\u0643 \u0645\u0635\u064a\u0628\u0629\u060c \u0641\u0644\u0627 \u064a\u0642\u0644: \n\"\u0644\u0648 \u0623\u0646\u064a \u0641\u0639\u0644\u062a\u064f \u0643\u0627\u0646 \u0643\u0630\u0627 \u0648\u0643\u0630\u0627\"\u061b \n\"\u0641\u0625\u0646 (\u0644\u0648) \u062a\u0641\u062a\u062d \u0639\u0645\u0644 \u0627\u0644\u0634\u064a\u0637\u0627\u0646\" \u0641\u064a \u0627\u0644\u0627\u0639\u062a\u0631\u0627\u0636 \u0639\u0644\u0649 \u0627\u0644\u0642\u062f\u0631\u060c \u0648\u0627\u0644\u062a\u0651\u064e\u062d\u064e\u0633\u0651\u064f\u0631\u0650 \u0639\u0644\u0649 \u0645\u0627 \u0641\u0627\u062a\u060c \u0648\u0644\u0643\u0646 \u064a\u0642\u0648\u0644 \u0645\u0633\u062a\u0633\u0644\u0645\u064b\u0627 \u0648\u0631\u0627\u0636\u064a\u064b\u0627: \"\u0642\u064e\u062f\u0631 \u0627\u0644\u0644\u0647\u060c \u0648\u0645\u0627 \u0634\u0627\u0621 \u0641\u0639\u0644\"\u060c\n\u0641\u0645\u0627 \u0648\u0642\u0639 \u0625\u0646\u0645\u0627 \u0647\u0648 \u0628\u0645\u0642\u062a\u0636\u0649 \u0645\u0627 \u0623\u0631\u0627\u062f\u0647 \u0627\u0644\u0644\u0647\u060c \u0641\u0625\u0646\u0647 \u0641\u0639\u0651\u064e\u0627\u0644\u064c \u0644\u0645\u0627 \u064a\u0631\u064a\u062f\u060c \u0648\u0644\u0627 \u0631\u0627\u062f\u0651 \u0644\u0642\u0636\u0627\u0626\u0647\u060c \u0648\u0644\u0627 \u0645\u064f\u0639\u064e\u0642\u0651\u0650\u0628 \u0644\u062d\u064f\u0643\u0652\u0645\u0650\u0647\u0650.","hints":["\u062a\u064e\u0641\u0627\u0648\u064f\u062a \u0627\u0644\u0646\u0627\u0633 \u0641\u064a \u0627\u0644\u0625\u064a\u0645\u0627\u0646.","\u0627\u0633\u062a\u062d\u0628\u0627\u0628 \u0627\u0644\u0642\u0648\u0629 \u0641\u064a \u0627\u0644\u0623\u0639\u0645\u0627\u0644\u061b \u0644\u0623\u0646\u0647 \u064a\u062d\u0635\u0644 \u0628\u0647\u0627 \u0645\u0646 \u0627\u0644\u0641\u0627\u0626\u062f\u0629\u0650 \u0645\u0627 \u0644\u0627 \u064a\u062d\u0635\u0644 \u0628\u0627\u0644\u0636\u0639\u0641.","\u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064f \u064a\u0646\u0628\u063a\u064a \u0623\u0646\u0652 \u064a\u062d\u0631\u0635\u064e \u0639\u0644\