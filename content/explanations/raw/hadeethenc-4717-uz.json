u0432\u0430 \u0451\u0440\u0434\u0430\u043c \u0431\u0435\u0440\u0430\u0434\u0438. \u0423\u043d\u0438\u043d\u0433 \u0434\u0438\u043d\u0438 \u0451\u043a\u0438 \u0434\u0443\u043d\u0451\u0441\u0438\u0434\u0430 \u0443\u043d\u0433\u0430 \u0441\u0430\u043c\u0438\u043c\u0438\u0439 \u043c\u0430\u0441\u043b\u0430\u04b3\u0430\u0442 \u0431\u0435\u0440\u0430\u0434\u0438.","hints":["\u041c\u0443\u0441\u0443\u043b\u043c\u043e\u043d \u043a\u0438\u0448\u0438 \u045e\u0437 \u0434\u0438\u043d\u0434\u043e\u0448\u0438 \u0443\u0447\u0443\u043d \u04b3\u0430\u043c \u045e\u0437\u0438\u0433\u0430 \u0451\u049b\u049b\u0430\u043d \u043d\u0430\u0440\u0441\u0430\u043d\u0438 \u044f\u0445\u0448\u0438 \u043a\u045e\u0440\u0438\u0448\u0438 \u0444\u0430\u0440\u0437\u0434\u0438\u0440. \u0427\u0443\u043d\u043a\u0438 \u043a\u0438\u043c \u045e\u0437 \u0434\u0438\u043d\u0434\u043e\u0448\u0438 \u0443\u0447\u0443\u043d \u045e\u0437\u0438\u0433\u0430 \u0451\u049b\u049b\u0430\u043d \u043d\u0430\u0440\u0441\u0430\u043d\u0438 \u044f\u0445\u0448\u0438 \u043a\u045e\u0440\u043c\u0430\u0441\u0430, \u0443\u043d\u0434\u0430 \u0438\u0439\u043c\u043e\u043d \u0439\u045e\u049b\u043b\u0438\u0433\u0438 \u04b3\u0430\u049b\u0438\u0434\u0430\u0433\u0438  \u04b3\u0430\u0434\u0438\u0441 \u0431\u0443 \u0438\u0448\u043d\u0438\u043d\u0433 \u0432\u043e\u0436\u0438\u0431\u043b\u0438\u0433\u0438\u0433\u0430 \u0434\u0430\u043b\u043e\u043b\u0430\u0442 \u049b\u0438\u043b\u0430\u0434\u0438.\r","\u0410\u043b\u043b\u043e\u04b3 \u0439\u045e\u043b\u0438\u0434\u0430\u0433\u0438 \u0431\u0438\u0440\u043e\u0434\u0430\u0440\u043b\u0438\u043a \u043d\u0430\u0441\u0430\u0431 (\u049b\u0430\u0440\u0438\u043d\u0434\u043e\u0448\u043b\u0438\u043a) \u0431\u0438\u0440\u043e\u0434\u0430\u0440\u043b\u0438\u0433\u0438\u0434\u0430\u043d \u04b3\u0430\u043c \u0443\u0441\u0442\u0443\u043d\u0434\u0438\u0440. \u0428\u0443\u043d\u0438\u043d\u0433 \u0443\u0447\u0443\u043d \u0443\u043d\u0438\u043d\u0433 \u04b3\u0430\u049b\u049b\u0438 \u044f\u043d\u0430\u0434\u0430 \u043a\