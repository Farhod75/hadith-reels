 \n\n\u0648\u0631\u062f\u0651\u064e\u062f\u064e \u0627\u0644\u0631\u062c\u0644\u064f \u0637\u064e\u0644\u064e\u0628\u064e \u0627\u0644\u0648\u0635\u064a\u0629\u0650 \u0645\u064e\u0631\u0651\u064e\u0627\u062a\u060c \u0641\u0644\u0645 \u064a\u064e\u0632\u0650\u062f\u0652\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0641\u064a \u0627\u0644\u0648\u0635\u064a\u0629 \u0639\u0644\u0649 \"\u0644\u0627 \u062a\u063a\u0636\u0628\".","hints_ar":["\u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0627\u0644\u063a\u0636\u0628 \u0648\u0623\u0633\u0628\u0627\u0628\u0647\u060c \u0641\u0625\u0646\u0647 \u062c\u0650\u0645\u0627\u0639\u064f \u0627\u0644\u0634\u0631\u060c \u0648\u0627\u0644\u062a\u062d\u0631\u0651\u064f\u0632\u064f \u0645\u0646\u0647 \u062c\u0645\u0627\u0639\u064f \u0627\u0644\u062e\u064a\u0631.","\u0627\u0644\u063a\u0636\u0628 \u0644\u0644\u0647 \u0643\u0627\u0644\u063a\u0636\u0628 \u0639\u0646\u062f \u0627\u0646\u062a\u0647\u0627\u0643 \u0645\u062d\u0627\u0631\u0645 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0627\u0644\u063a\u0636\u0628 \u0627\u0644\u0645\u062d\u0645\u0648\u062f.","\u062a\u064e\u0643\u0631\u0627\u0631 \u0627\u0644\u0643\u0644\u0627\u0645 \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629 \u062d\u062a\u0649 \u064a\u064e\u0639\u0650\u064a\u064e\u0647 \u0627\u0644\u0633\u0627\u0645\u0639\u064f \u0648\u064a\u064f\u062f\u0631\u0643 \u0623\u0647\u0645\u064a\u062a\u064e\u0647.","\u0641\u0636\u064a\u0644\u0629 \u0637\u0644\u0628 \u0627\u0644\u0648\u0635\u064a\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0644\u0650\u0645."],"words_meanings_ar":[],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0627\u0644\u0628\u062e\u0627\u0631\u064a","grade_ar":"\u0635\u062d\u064a\u062d"}