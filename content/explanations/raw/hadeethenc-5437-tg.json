da"],"hadeeth_intro":"\u0410\u0437 \u0410\u0431\u0443\u04b3\u0443\u0440\u0430\u0439\u0440\u0430 (\u0425\u0443\u0434\u043e\u0432\u0430\u043d\u0434 \u0430\u0437 \u04ef \u0440\u043e\u0437\u04e3 \u0431\u043e\u0434) \u0440\u0438\u0432\u043e\u044f\u0442 \u0430\u0441\u0442, \u043a\u0438 \u041f\u0430\u0451\u043c\u0431\u0430\u0440 (\u0421\u0430\u043b\u043e\u043c\u0443 \u0434\u0443\u0440\u0443\u0434\u0438 \u0410\u043b\u043b\u043e\u04b3 \u0431\u0430\u0440 \u04ef \u0431\u043e\u0434) \u0444\u0430\u0440\u043c\u0443\u0434\u0430\u043d\u0434:","hadeeth_ar":"\u0639\u0646 \u0623\u0628\u064a \u0647\u0631\u064a\u0631\u0629 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0639\u0646 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0642\u0627\u0644: \u00ab\u0645\u064e\u0646\u0652 \u0643\u064e\u0627\u0646\u064e \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0627\u0644\u0644\u0647\u0650 \u0648\u064e\u0627\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u0650 \u0627\u0644\u0652\u0622\u062e\u0650\u0631\u0650 \u0641\u064e\u0644\u0652\u064a\u064e\u0642\u064f\u0644\u0652 \u062e\u064e\u064a\u0652\u0631\u064b\u0627 \u0623\u064e\u0648\u0652 \u0644\u0650\u064a\u064e\u0635\u0652\u0645\u064f\u062a\u0652\u060c \u0648\u064e\u0645\u064e\u0646\u0652 \u0643\u064e\u0627\u0646\u064e \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0627\u0644\u0644\u0647\u0650 \u0648\u064e\u0627\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u0650 \u0627\u0644\u0652\u0622\u062e\u0650\u0631\u0650 \u0641\u064e\u0644\u0652\u064a\u064f\u0643\u0652\u0631\u0650\u0645\u0652 \u062c\u064e\u0627\u0631\u064e\u0647\u064f\u060c \u0648\u064e\u0645\u064e\u0646\u0652 \u0643\u064e\u0627\u0646\u064e \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0627\u0644\u0644\u0647\u0650 \u0648\u064e\u0627\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u0650 \u0627\u0644\u0652\u0622\u062e\u0650\u0631\u0650 \u0641\u06