64a\u064e\u062c\u0652\u0631\u064a \u062b\u0648\u0627\u0628\u064f\u0647\u0627 \u0648\u064a\u062f\u0648\u0645\u060c \u063a\u064a\u0631 \u0627\u0644\u0645\u064f\u0646\u0642\u064e\u0637\u0650\u0639 \u0643\u0627\u0644\u0648\u0642\u0641\u060c \u0648\u0628\u0646\u0627\u0621 \u0627\u0644\u0645\u0633\u0627\u062c\u062f\u060c \u0648\u062d\u0641\u0631 \u0627\u0644\u0622\u0628\u0627\u0631\u060c \u0648\u063a\u064a\u0631 \u0630\u0644\u0643.\n\n\u0627\u0644\u062b\u0627\u0646\u064a: \u0627\u0644\u0639\u0644\u0645 \u0627\u0644\u0630\u064a \u064a\u064e\u0646\u062a\u0641\u0650\u0639\u064f \u0628\u0647 \u0627\u0644\u0646\u0627\u0633\u060c \u0643\u062a\u0635\u0646\u064a\u0641 \u0643\u062a\u0628 \u0627\u0644\u0639\u0644\u0645\u060c \u0623\u0648 \u0643\u0623\u0646\u0652 \u064a\u064f\u0639\u064e\u0644\u0651\u0650\u0645\u064e \u0634\u062e\u0635\u064b\u0627\u060c \u0641\u064a\u0642\u0648\u0645 \u0630\u0644\u0643 \u0627\u0644\u0634\u062e\u0635 \u0628\u0646\u0634\u0631 \u0630\u0644\u0643 \u0627\u0644\u0639\u0644\u0645 \u0628\u0639\u062f \u0645\u0648\u062a\u0647.\n\n\u0627\u0644\u062b\u0627\u0644\u062b: \u0627\u0644\u0648\u0644\u062f \u0627\u0644\u0635\u0627\u0644\u062d \u0627\u0644\u0645\u0624\u0645\u0646 \u064a\u062f\u0639\u0648 \u0644\u0648\u0627\u0644\u062f\u064a\u0647.","hints_ar":["\u0623\u062c\u0645\u0639 \u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645 \u0639\u0644\u0649 \u0623\u0646\u0651 \u0645\u0645\u0627 \u064a\u064e\u0644\u0652\u062d\u064e\u0642\u064f \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064e \u0628\u0639\u062f \u0645\u0648\u062a\u0647 \u0645\u0646 \u0627\u0644\u062b\u0648\u0627\u0628: \u0627\u0644\u0635\u062f\u0642\u0629 \u0627\u0644\u062c\u0627\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u0639\u0644\u0645 \u0627\u0644\u0630\u064a \u064a\u0646\u062a\u0641\u0639 \u0628\u0647\u060c \u0648\u0627\u0644\u062f\u0639\u0627\u0621\u060c \u0648\u0648\u0631\u062f \u0641\u064a \u0627\u0644\u0623\u062d\u0627\u062f\u064a\u062b \u0627\u0644\u0623\u062e\u0631\u0649: \u0627\u0644\u062d\u062c \u0623\u064a\u0636\u064b\u0627.","\u062e\u0635 \u0647\u0630\u0647 \u0627\u0644\u062b\u0644\u0627\u062b\u0629 \u0628\u0627\u0644\u0630\u0643\u0631 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062d\u062f\u064a\u062b\u061b \u0644\u0623\u0646\u0647\u0627 \u0623\u0635\u0648\u0644 \u0627\u0644\u062e\u064a\u0631\u060c \u0648\u0623\u063a\u0644\u0628 \u0645\u0627 \u064a\u0642\u0635\u062f \u0623\u0647\u0644 \u0627\u0644\u0641\u0636\u0644 \u0628\u0642\u0627\u0621\u064e\u0647 \u0628\u0639\u062f\u0647\u0645.","\u0643\u0644 \u0639\u0644\u0645 \u064a\u064f\u0646\u062a\u064e\u0641\u064e\u0639 \u0628\u0647 \u0641\u0625\u0646\u0647 \u064a\u062d\u0635\u0644 \u0644\u0647 \u0627\u0644\u0623\u062c\u0631\u060c \u0644\u0643\u0646 \u0639\u0644\u0649 \u0631\u0623\u0633\u0647\u0627 \u0648\u0642\u0645\u0651\u064e\u062a\u0650\u0647\u0627 \u0627\u0644\u0639\u0644\u0645\u064f \u0627\u0644\u0634\u0631\u0639\u064a \u0648\u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0645\u0633\u0627\u0646\u062f\u0629 \u0644\u0647.","\u0627\u0644\u0639\u0644\u0645 \u0623\u0646\u0641\u0639 \u0647\u0630\u0647 \u0627\u0644\u062b\u0644\u0627\u062b\u061b \u0644\u0623\u0646 \u0627\u0644\u0639\u0644\u0645 \u064a\u0646\u062a\u0641\u0639 \u0628\u0647 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0627\u0644\u0630\u064a \u064a\u062a\u0639\u0644\u0645\u0647\u060c \u0627\u0644\u0639\u0644\u0645 \u0641\u064a\u0647 \u062d\u0641\u0638 \u0627\u0644\u0634\u0631\u064a\u0639\u0629\u060c \u0641\u064a\u0647 \u0646\u0641\u0639 \u0627\u0644\u062e\u0644\u0642 \u0639\u0645\u0648\u0645\u064b\u0627\u060c \u0648\u0647\u0648 \u0623\u0634\u0645\u0644 \u0648\u0623\u0639\u0645 \u0644\u0623\u0646\u0647 \u064a\u062a\u0639\u0644\u0645 \u0645\u0646 \u0639\u0644\u0645\u0643 \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0641\u064a \u062d\u064a\u0627\u062a\u0643 \u0648\u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0628\u0639\u062f \u0648\u0641\u0627\u062a\u0643.","\u0627\u0644\u062d\u062b \u0639\u0644\u0649 \u062a\u0631\u0628\u064a\u0629 \u0627\u0644\u0623\u0648\u0644\u0627\u062f \u0627\u0644\u0635\u0627\u0644\u062d\u064a\u0646\u061b \u0641\u0647\u0645 \u0627\u0644\u0630\u064a\u0646 \u064a\u0646\u0641\u0639\u0648\u0646 \u0648\u0627\u0644\u062f\u064a\u0647\u0645 \u0641\u064a \u0627\u0644\u0622\u062e\u0631\u0629\u060c \u0648\u0645\u0650\u0646 \u0646\u064e\u0641\u0652\u0639\u0650\u0647\u0645 \u0623\u0646\u0647\u0645 \u064a\u062f\u0639\u0648\u0646 \u0644\u0647\u0645.","\u0627\u0644\u062d\u062b \u0639\u0644\u0649 \u0627\u0644\u0625\u062d\u0633\u0627\u0646 \u0625\u0644\u0649 \u0627\u0644\u0648\u0627\u0644\u062f\u064a\u0646 \u0628\u0639\u062f \u0645\u0648\u062a\u0647\u0645\u0627\u060c \u0648\u0647\u0648 \u0623\u064a\u0636\u0627 \u0645\u0646 \u0627\u0644\u0628\u0631 \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0641\u064a\u062f \u0627\u0644\u0648\u0644\u062f \u0645\u0646\u0647.","\u0627\u0644\u062f\u0639\u0627\u0621 \u064a\u0646\u0641\u0639 \u0627\u0644\u0645\u064a\u062a \u0648\u0644\u0648 \u0643\u0627\u0646 \u0645\u0646 \u063a\u064a\u0631 \u0627\u0644\u0648\u0644\u062f\u060c \u0648\u0644\u0643\u0646 \u062e\u0635 \u0627\u0644\u0648\u0644\u062f \u0628\u0627\u0644\u0630\u0643\u0631 \u0644\u0623\u0646\u0647 \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0645\u0631 \u0641\u064a \u0627\u0644\u062f\u0639\u0627\u0621 \u0644\u0644\u0634\u062e\u0635 \u063a\u0627\u0644\u0628\u064b\u0627 \u0625\u0644\u0649 \u0623\u0646 \u064a\u0645\u0648\u062a \u0647\u0648."],"words_meanings_ar":[],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0645\u0633\u0644\u0645","grade_ar":"\u0635\u062d\u064a\u062d"}