# hadith-reels — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain a real key.
#
# Derived from what the code actually reads:
#   git grep -oh "process\.env\.[A-Z_]*" -- "app/**" "scripts/**" "*.ts"
# Keep it that way. A key documented here that nothing reads is worse than no
# documentation, because it looks authoritative.

# ---------------------------------------------------------------- required

# Reel text generation (story / moral / context / caption)
ANTHROPIC_API_KEY=

# Hadith library. SHARED WITH hadith-verifier — same project, same tables.
# A write here affects both apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Narration (ElevenLabs eleven_v3)
ELEVENLABS_API_KEY=

# Kling video, VEED Fabric lip-sync, FLUX stills. All three bill to this key.
FAL_KEY=

# Gates /admin. Without it the admin UI is unusable.
ADMIN_PASSWORD=

# ---------------------------------------------------------------- optional

# Telegram. CHANNEL is where reels publish; ALERT is operational notifications.
# Two different destinations — do not merge them.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_CHANNEL_CHAT_ID=

# ---------------------------------------------------------------- voices

# Twelve per-slot voice overrides exist:
#   ELEVENLABS_VOICE_{EN,RU,UZ,TJ,AR}_{ADULTS,KIDS,KIDS_BOY}
#
# In practice only ELEVENLABS_VOICE_EN_KIDS has ever been set. Every other slot
# resolves to its hardcoded fallback in VOICE_MAP, which means THE FALLBACKS ARE
# THE CONFIGURATION — a wrong fallback is not unreachable dead code. P118 shipped
# two reels in an American voice labelled as Russian for exactly this reason.
#
# Leave these unset unless overriding a specific slot. app/api/tts/route.ts is
# the source of truth for which voice each slot resolves to.
#
# ELEVENLABS_VOICE_EN_KIDS=

# ---------------------------------------------------------------- notes

# PowerShell and Python scripts do NOT read process.env. generate-scene.ps1
# parses .env.local directly for FAL_KEY; the Python scripts try a fallback
# chain (SUPABASE_SERVICE_ROLE_KEY, then SUPABASE_SERVICE_KEY, SERVICE_ROLE_KEY,
# SUPABASE_KEY) — setting the first name satisfies all of them.
#
# generate-talking-clip.py reads FAL_KEY from the process environment, not from
# .env.local:  $env:FAL_KEY="..."
#
# BASE_URL, CI, NODE_ENV, VERCEL and VERCEL_URL appear in the code but are set
# by the runtime or the test harness. Do not put them here.
